// Enforce safe types during the TypeScript migration. Use only through tooling/lint.mjs.
{
  "plugins": ["typescript"],
  // Disable the default correctness category so only the rules below run.
  "categories": { "correctness": "off" },
  "options": {
    "typeAware": true,
    "respectEslintDisableDirectives": false
  },
  // Oxlint 1.94.0 has no rule for super-linear regex backtracking.
  // The task that adds the first validator adds an overrides entry for that file alone.
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error"
  }
}
